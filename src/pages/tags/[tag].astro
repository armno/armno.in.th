---
import PageLayout from "@layouts/PageLayout.astro";
import PostArchive from "@components/PostArchive.astro";
import SearchBox from "@components/SearchBox.astro";
import { getSortedPosts, postTags } from "@shared/posts";

export async function getStaticPaths() {
  const sortedPosts = await getSortedPosts();
  const uniqueTags = [...new Set(sortedPosts.flatMap(postTags))];

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: { posts: sortedPosts.filter((post) => postTags(post).includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const content = {
  title: `Posts tagged “${tag}”`,
  description: `Posts tagged “${tag}”`,
  thumbnail: "",
  language: "en",
};
---

<PageLayout frontmatter={content} isPost={false} hasSearch={true} wide={true}>
  <SearchBox slot="search" />

  <PostArchive posts={posts} title={`#${tag}`} backHref="/blog" />
</PageLayout>
