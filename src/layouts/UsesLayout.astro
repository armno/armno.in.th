---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/ibm-plex-sans-thai-looped/thai-400.css';
import '@fontsource/ibm-plex-sans-thai-looped/thai-700.css';

import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import BaseHead from '@components/BaseHead.astro';
import GlobalStyle from '@components/GlobalStyle.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    thumbnail: string;
    language: string;
  };
}

const { frontmatter } = Astro.props;
const { title, description, thumbnail, language } = frontmatter;
// description may contain HTML for display; meta tags need plain text
const plainDescription = description?.replace(/<[^>]+>/g, '');
---
<html lang={language ? language : 'th'}>
  <head>
    <BaseHead {title} description={plainDescription} {thumbnail} />
    <GlobalStyle />
    <style is:global>
      [data-uses-stack] figure {
        transform-origin: top center;
        transition:
          transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 600ms cubic-bezier(0.22, 1, 0.36, 1);
        opacity: 0;
        transform: translateY(60px) scale(0.86);
        pointer-events: none;
      }
      [data-uses-stack] figure[data-stack="0"] {
        opacity: 1;
        transform: translateY(0) scale(1);
        z-index: 10;
        pointer-events: auto;
      }
      [data-uses-stack] figure[data-stack="1"] {
        opacity: 0.25;
        transform: translateY(-14px) scale(0.92);
        z-index: 9;
      }
      [data-uses-stack] figure[data-stack="2"] {
        opacity: 0.12;
        transform: translateY(-26px) scale(0.84);
        z-index: 8;
      }
      [data-uses-stack] figure[data-stack="3"] {
        opacity: 0.06;
        transform: translateY(-36px) scale(0.76);
        z-index: 7;
      }
      [data-uses-stack] [data-uses-placeholder] {
        transition: opacity 500ms cubic-bezier(0.22, 1, 0.36, 1);
      }
      [data-lightbox-dialog][open],
      [data-lightbox-dialog][open]::backdrop {
        opacity: 1;
        transition: opacity 250ms ease-out;
      }
      @starting-style {
        [data-lightbox-dialog][open],
        [data-lightbox-dialog][open]::backdrop {
          opacity: 0;
        }
      }
    </style>
  </head>
  <body class="font-serif antialiased dark:bg-zinc-900 transition-colors">
    <Header />

    <main class="mt-20 mx-auto pb-24 px-6 max-w-6xl">
      <header class="mb-12 lg:mb-20">
        <h1 class="font-bold tracking-tight text-4xl lg:text-5xl dark:text-slate-200">{title}</h1>
        {description && (
          <p class="mt-3 text-base lg:text-lg prose dark:prose-invert dark:text-slate-200" set:html={description} />
        )}
      </header>

      <div class="grid gap-10 lg:gap-16 lg:grid-cols-2">
        <aside class="hidden lg:block [container-type:inline-size]">
          <div class="sticky top-[calc(50vh-37.5cqw)]">
          <div class="relative w-full" data-uses-stack>
            <div
              class="aspect-[4/3] rounded-md border border-slate-200 bg-slate-100 dark:border-zinc-700 dark:bg-zinc-800 shadow-[0_12px_40px_-12px_rgba(15,23,42,0.45)] dark:shadow-black/50"
              data-uses-placeholder
            ></div>
          </div>
          </div>
        </aside>

        <div class="prose lg:prose-lg dark:prose-invert dark:text-slate-200 main leading-6">
          <slot />
        </div>
      </div>
    </main>

    <Footer />

    <dialog
      data-lightbox-dialog
      class="px-0 py-12 bg-transparent max-w-none max-h-none w-screen h-screen outline-none backdrop:bg-black/85 cursor-zoom-out"
    >
      <img src="" alt="" class="w-full h-full object-contain" />
    </dialog>

    <script is:inline>
      (function () {
        const dialog = document.querySelector('[data-lightbox-dialog]');
        if (!dialog) return;
        const full = dialog.querySelector('img');
        document.addEventListener('click', (e) => {
          const img = e.target.closest('img[data-lightbox]');
          if (!img) return;
          full.src = img.src;
          full.alt = img.alt;
          dialog.showModal();
        });
        dialog.addEventListener('click', () => dialog.close());
        dialog.addEventListener('close', () => { full.src = ''; });
      })();
    </script>

    <script is:inline>
      (function () {
        const stack = document.querySelector('[data-uses-stack]');
        if (!stack) return;
        // Build the desktop stack from the images each section renders for mobile
        document.querySelectorAll('[data-uses-section][data-image-id] img[data-uses-image]').forEach((source, idx) => {
          const figure = document.createElement('figure');
          figure.className = 'absolute inset-x-0 top-0 m-0';
          figure.dataset.imageId = source.closest('[data-uses-section]').dataset.imageId;
          figure.dataset.imageIndex = String(idx);
          const img = source.cloneNode();
          img.className = 'w-full h-auto rounded-md shadow-[0_12px_40px_-12px_rgba(15,23,42,0.45)] dark:shadow-black/50 cursor-zoom-in';
          img.removeAttribute('data-uses-image');
          img.setAttribute('data-lightbox', '');
          figure.appendChild(img);
          stack.appendChild(figure);
        });
        const figures = [];
        stack.querySelectorAll('[data-image-id][data-image-index]').forEach((el) => {
          figures.push({ id: el.dataset.imageId, idx: parseInt(el.dataset.imageIndex, 10), el });
        });
        figures.sort((a, b) => a.idx - b.idx);
        const byId = new Map(figures.map((f) => [f.id, f]));
        const placeholder = stack.querySelector('[data-uses-placeholder]');

        let activeId = null;
        const setActive = (id) => {
          if (id === activeId) return;
          activeId = id;
          if (id === null) {
            for (const f of figures) f.el.removeAttribute('data-stack');
            if (placeholder) placeholder.style.opacity = '1';
            return;
          }
          const activeIdx = byId.get(id).idx;
          for (const f of figures) {
            const dist = activeIdx - f.idx;
            if (dist < 0) {
              // upcoming — not yet in stack, falls back to default hidden state
              f.el.removeAttribute('data-stack');
            } else {
              f.el.setAttribute('data-stack', String(Math.min(dist, 3)));
            }
          }
          if (placeholder) placeholder.style.opacity = '0';
        };

        const tracked = [...document.querySelectorAll('[data-uses-section][data-image-id]')];
        let scheduled = false;
        const update = () => {
          scheduled = false;
          const trigger = stack.getBoundingClientRect().top + 8;
          let next = tracked.length > 0 ? tracked[0].dataset.imageId : null;
          for (const el of tracked) {
            if (el.getBoundingClientRect().top <= trigger) next = el.dataset.imageId;
          }
          setActive(next);
        };
        const onScroll = () => {
          if (scheduled) return;
          scheduled = true;
          requestAnimationFrame(update);
        };
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        update();
      })();
    </script>
  </body>
</html>
