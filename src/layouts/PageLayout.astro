---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/ibm-plex-sans-thai-looped/thai-400.css'
import '@fontsource/ibm-plex-sans-thai-looped/thai-600.css'
import '@fontsource/ibm-plex-sans-thai-looped/thai-700.css'

import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import BaseHead from '@components/BaseHead.astro';
import GlobalStyle from '@components/GlobalStyle.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    thumbnail: string;
    language: string;
  };
  isPost: boolean;
  hasSearch?: boolean;
  wide?: boolean;
}

const { frontmatter, isPost, hasSearch, wide = false } = Astro.props;
const { title, description, thumbnail, language } = frontmatter;

const TagName = isPost ? 'article' : 'main';
const bodyClass = wide ? 'bg-bg text-ink' : 'dark:bg-zinc-900';
const mainClass = wide
  ? 'main'
  : 'mt-20 mx-auto pb-24 prose lg:prose-lg main leading-6 px-6 md:px-0 dark:prose-invert dark:text-slate-200';
---
<html lang={language ? language : 'th'}>
	<head>
		<BaseHead {title} {description} {thumbnail} />
    {hasSearch &&
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    }
    <GlobalStyle />
	</head>
	<body class={`font-serif antialiased transition-colors ${bodyClass}`} data-pagefind-body={isPost || undefined} data-pagefind-ignore={isPost ? 'index' : 'all'}>
		<Header>
      {hasSearch && <slot name="search" slot="search" />}
    </Header>
    <TagName class={mainClass}>
      {isPost && <slot name="post-header" />}
      <slot />
    </TagName>
    <Footer />

    {isPost && (
      <>
        <style is:global>
          [data-lightbox-dialog][open],
          [data-lightbox-dialog][open]::backdrop {
            opacity: 1;
            transition: opacity 250ms ease-out;
          }
          @starting-style {
            [data-lightbox-dialog][open],
            [data-lightbox-dialog][open]::backdrop {
              opacity: 0;
            }
          }
        </style>
        <dialog
          data-lightbox-dialog
          aria-label="Image preview"
          class="px-0 py-12 bg-transparent max-w-none max-h-none w-screen h-screen outline-none backdrop:bg-black/85 cursor-zoom-out"
        >
          <img src="/favicon.ico" alt="" class="w-full h-full object-contain" />
        </dialog>

        <script is:inline>
          (function () {
            const content = document.querySelector('[data-post-content]');
            const dialog = document.querySelector('[data-lightbox-dialog]');
            if (!content || !dialog) return;

            const full = dialog.querySelector('img');
            content.querySelectorAll('img').forEach((img) => {
              img.setAttribute('data-lightbox', '');
              img.classList.add('cursor-zoom-in');
            });

            document.addEventListener('click', (e) => {
              if (!(e.target instanceof Element)) return;
              const img = e.target.closest('img[data-lightbox]');
              if (!img) return;
              e.preventDefault();
              full.src = img.currentSrc || img.src;
              full.alt = img.alt;
              dialog.showModal();
            });

            dialog.addEventListener('click', () => dialog.close());
            dialog.addEventListener('close', () => {
              full.src = '/favicon.ico';
              full.alt = '';
            });
          })();
        </script>
      </>
    )}
	</body>
</html>
