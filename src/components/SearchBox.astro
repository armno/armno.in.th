<div id="search">
  <input
    type="search"
    aria-label="Search all blog posts"
    aria-describedby="search-help"
    placeholder="Search posts"
    class="h-[calc(64px*var(--pagefind-ui-scale))] w-full rounded-[3px] border border-border bg-transparent px-4 text-[calc(21px*var(--pagefind-ui-scale))] font-normal text-ink placeholder:text-ink placeholder:opacity-50"
  />
</div>
<p id="search-help" class="sr-only">
  Search every post by title and content. Press <kbd>⌘K</kbd> or <kbd>Ctrl K</kbd> to jump here.
</p>
<script>
  interface PagefindInstance {
    triggerSearch(term: string): void;
  }

  interface PagefindWindow extends Window {
    PagefindUI: new (options: {
      element: string;
      showSubResults: boolean;
      showImages: boolean;
      translations: { placeholder: string };
    }) => PagefindInstance;
  }

  const search = document.querySelector<HTMLElement>("#search")!;
  const fallback = search.querySelector<HTMLInputElement>("input")!;
  let loading: Promise<void> | undefined;
  let pagefind: PagefindInstance | undefined;

  function loadPagefind(): Promise<void> {
    if (loading) return loading;

    loading = new Promise<void>((resolve, reject) => {
      const stylesheet = document.createElement("link");
      stylesheet.rel = "stylesheet";
      stylesheet.href = "/pagefind/pagefind-ui.css";
      document.head.appendChild(stylesheet);

      const script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = () => resolve();
      script.onerror = () => {
        stylesheet.remove();
        script.remove();
        reject(new Error("Could not load search"));
      };
      document.head.appendChild(script);
    }).then(() => {
      const term = fallback.value;
      const wasFocused = document.activeElement === fallback;
      fallback.remove();
      pagefind = new (window as unknown as PagefindWindow).PagefindUI({
        element: "#search",
        showSubResults: false,
        showImages: false,
        translations: {
          placeholder: window.matchMedia("(min-width: 820px)").matches ? "Search (⌘K)" : "Search posts",
        },
      });

      const input = search.querySelector<HTMLInputElement>('input[type="text"]');
      input?.setAttribute("aria-label", "Search all blog posts");
      input?.setAttribute("aria-describedby", "search-help");
      if (wasFocused) input?.focus();
      if (term) pagefind.triggerSearch(term);

      input?.addEventListener("input", updateSearchParam);
      input?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") queueMicrotask(updateSearchParam);
      });
      search.querySelector(".pagefind-ui__search-clear")
        ?.addEventListener("click", () => queueMicrotask(updateSearchParam));
    }).catch((error) => {
      loading = undefined;
      console.error(error);
    });

    return loading;
  }

  function updateSearchParam() {
    const input = search.querySelector<HTMLInputElement>("input");
    const url = new URL(window.location.href);

    if (input?.value) {
      url.searchParams.set("search", input.value);
    } else {
      url.searchParams.delete("search");
    }

    window.history.replaceState({}, "", url);
  }

  fallback.addEventListener("focus", () => { void loadPagefind(); });
  fallback.addEventListener("input", updateSearchParam);

  const searchTerm = new URLSearchParams(window.location.search).get("search");
  if (searchTerm) {
    fallback.value = searchTerm;
    void loadPagefind();
  }

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === "k") {
      event.preventDefault();
      search.querySelector<HTMLInputElement>("input")?.focus();
    }
  });
</script>
