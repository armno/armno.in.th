<div id="search" aria-describedby="search-help"></div>
<p id="search-help" class="sr-only">
  Search every post by title and content. Press <kbd>⌘K</kbd> or <kbd>Ctrl K</kbd> to jump here.
</p>
<script>
  window.addEventListener("DOMContentLoaded", () => {
    const pagefind = new PagefindUI({
      element: "#search",
      showSubResults: false,
      showImages: false,
      translations: {
        placeholder: window.matchMedia("(min-width: 820px)").matches ? 'Search (⌘K)' : 'Search posts',
      }
    });

    const input = document.querySelector<HTMLInputElement>('#search input[type="text"]');
    input?.setAttribute("aria-label", "Search all blog posts");
    input?.setAttribute("aria-describedby", "search-help");
    const updateSearchParam = () => {
      if (!input) return;

      const url = new URL(window.location.href);

      if (input.value) {
        url.searchParams.set("search", input.value);
      } else {
        url.searchParams.delete("search");
      }

      window.history.replaceState({}, "", url);
    };

    input?.addEventListener("input", updateSearchParam);
    input?.addEventListener("keydown", (event) => {
      if (event.key === "Escape") updateSearchParam();
    });

    document.querySelector("#search .pagefind-ui__search-clear")
      ?.addEventListener("click", updateSearchParam);

    const searchTerm = new URLSearchParams(window.location.search).get("search");
    if (searchTerm) {
      pagefind.triggerSearch(searchTerm);
    }
  });

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === "k") {
      const input = document.querySelector<HTMLInputElement>('#search input[type="text"]');
      if (input) {
        input.focus();
      }
    }
  });
</script>
