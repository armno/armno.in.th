<div id="search">
  <div data-search-fallback class="relative">
    <svg
      aria-hidden="true"
      viewBox="0 0 18 18"
      fill="currentColor"
      class="pointer-events-none absolute top-[calc(23px*var(--pagefind-ui-scale))] left-[calc(20px*var(--pagefind-ui-scale))] size-[calc(18px*var(--pagefind-ui-scale))] text-ink opacity-70"
    >
      <path d="M12.7549 11.255H11.9649L11.6849 10.985C12.6649 9.845 13.2549 8.365 13.2549 6.755C13.2549 3.165 10.3449 0.255005 6.75488 0.255005C3.16488 0.255005 0.254883 3.165 0.254883 6.755C0.254883 10.345 3.16488 13.255 6.75488 13.255C8.36488 13.255 9.84488 12.665 10.9849 11.685L11.2549 11.965V12.755L16.2549 17.745L17.7449 16.255L12.7549 11.255ZM6.75488 11.255C4.26488 11.255 2.25488 9.245 2.25488 6.755C2.25488 4.26501 4.26488 2.255 6.75488 2.255C9.24488 2.255 11.2549 4.26501 11.2549 6.755C11.2549 9.245 9.24488 11.255 6.75488 11.255Z" />
    </svg>
    <input
      type="text"
      aria-label="Search all blog posts"
      aria-describedby="search-help"
      placeholder="Search posts"
      class="h-[calc(64px*var(--pagefind-ui-scale))] w-full appearance-none rounded-[3px] border border-border bg-[var(--pagefind-ui-background,#fff)] pr-[calc(70px*var(--pagefind-ui-scale))] pl-[calc(54px*var(--pagefind-ui-scale))] text-[calc(21px*var(--pagefind-ui-scale))] font-normal text-ink placeholder:text-ink placeholder:opacity-50 focus-visible:outline-1 focus-visible:-outline-offset-1 focus-visible:outline-ink"
    />
    <script is:inline>
      if (window.matchMedia("(min-width: 820px)").matches) {
        document.currentScript.previousElementSibling.placeholder = "Search (⌘K)";
      }
    </script>
  </div>
</div>
<p id="search-help" class="sr-only">
  Search every post by title and content. Press <kbd>⌘K</kbd> or <kbd>Ctrl K</kbd> to jump here.
</p>
<script>
  interface PagefindInstance {
    triggerSearch(term: string): void;
  }

  interface PagefindWindow extends Window {
    PagefindUI: new (options: {
      element: string;
      showSubResults: boolean;
      showImages: boolean;
      translations: { placeholder: string };
    }) => PagefindInstance;
  }

  const search = document.querySelector<HTMLElement>("#search")!;
  const fallbackWrapper = search.querySelector<HTMLElement>("[data-search-fallback]")!;
  const fallback = fallbackWrapper.querySelector<HTMLInputElement>("input")!;
  let loading: Promise<void> | undefined;
  let pagefind: PagefindInstance | undefined;

  function loadPagefind(): Promise<void> {
    if (loading) return loading;

    loading = new Promise<void>((resolve, reject) => {
      const stylesheet = document.createElement("link");
      stylesheet.rel = "stylesheet";
      stylesheet.href = "/pagefind/pagefind-ui.css";
      // Insert first so the site's --pagefind-ui-* overrides in GlobalStyle still win.
      document.head.prepend(stylesheet);

      const script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onload = () => resolve();
      script.onerror = () => {
        stylesheet.remove();
        script.remove();
        reject(new Error("Could not load search"));
      };
      document.head.appendChild(script);
    }).then(() => {
      const term = fallback.value;
      const wasFocused = document.activeElement === fallback;
      fallbackWrapper.remove();
      pagefind = new (window as unknown as PagefindWindow).PagefindUI({
        element: "#search",
        showSubResults: false,
        showImages: false,
        translations: {
          placeholder: fallback.placeholder,
        },
      });

      const input = search.querySelector<HTMLInputElement>('input[type="text"]');
      input?.setAttribute("aria-label", "Search all blog posts");
      input?.setAttribute("aria-describedby", "search-help");
      if (wasFocused) input?.focus();
      if (term) pagefind.triggerSearch(term);

      input?.addEventListener("input", updateSearchParam);
      input?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") queueMicrotask(updateSearchParam);
      });
      search.querySelector(".pagefind-ui__search-clear")
        ?.addEventListener("click", () => queueMicrotask(updateSearchParam));
    }).catch((error) => {
      loading = undefined;
      console.error(error);
    });

    return loading;
  }

  function updateSearchParam() {
    const input = search.querySelector<HTMLInputElement>("input");
    const url = new URL(window.location.href);

    if (input?.value) {
      url.searchParams.set("search", input.value);
    } else {
      url.searchParams.delete("search");
    }

    window.history.replaceState({}, "", url);
  }

  fallback.addEventListener("focus", () => { void loadPagefind(); });
  fallback.addEventListener("input", updateSearchParam);

  const searchTerm = new URLSearchParams(window.location.search).get("search");
  if (searchTerm) {
    fallback.value = searchTerm;
    void loadPagefind();
  }

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === "k") {
      event.preventDefault();
      search.querySelector<HTMLInputElement>("input")?.focus();
    }
  });
</script>
