---
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  image?: string;
  imageAlt?: string;
}

const { id, image, imageAlt = '' } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../pages/uses/content/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const fileName = image?.split('/').pop();
const imageData = fileName ? images[`../pages/uses/content/${fileName}`]?.default : undefined;
---
<section
  id={id}
  data-uses-section
  data-image-id={imageData ? id : undefined}
  class="scroll-mt-24 lg:pt-8 lg:mb-32"
>
  <slot />
  {imageData && (
    <img
      src={imageData.src}
      alt={imageAlt}
      width={imageData.width}
      height={imageData.height}
      class="lg:hidden mt-4 mb-12 rounded-md w-full h-auto"
      loading="lazy"
      data-uses-image
    />
  )}
</section>
