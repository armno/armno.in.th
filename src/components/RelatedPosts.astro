---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { format } from 'date-fns';

interface Props {
  tags: string[];
  currentPathname: string;
}

const allPosts = await getCollection('blog');
const { tags = [], currentPathname } = Astro.props;

const relatedPosts = allPosts
  .filter(post => !currentPathname.includes(post.id))
  .filter(post => !!post.data.tags)
  .map((post) => {
    const matchedTags = post.data.tags?.filter((tag) =>
      tags.some((currentTag) => currentTag.toLowerCase() === tag.toLowerCase())
    ) ?? [];

    return { post, matchedTags };
  })
  .filter(({ matchedTags }) => matchedTags.length > 0)
  .sort((a, b) => {
    if (b.matchedTags.length !== a.matchedTags.length) {
      return b.matchedTags.length - a.matchedTags.length;
    }

    return new Date(b.post.data.pubDate).valueOf() - new Date(a.post.data.pubDate).valueOf();
  });

const [featured, ...secondaryPosts] = relatedPosts.slice(0, 4);

// Thumbnails live in public/ so Astro can't resize them. In production, ask Netlify Image CDN for a smaller copy.
function resizedThumbnail(thumbnail: string, width: number) {
  if (!import.meta.env.PROD) return thumbnail;
  return `/.netlify/images?url=${encodeURIComponent(thumbnail)}&w=${width}`;
}
---

{
  featured && (
    <section class="not-prose mt-24 border-t border-line pt-8 lg:ml-[calc(50%-50vw)] lg:w-screen" data-pagefind-ignore>
      <div class="mx-auto max-w-6xl lg:px-12 xl:px-16">
        <div class="mb-8 flex items-baseline justify-between gap-4">
          <h2 class="m-0 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Keep reading</h2>
          <span class="hidden text-xs uppercase tracking-[0.16em] text-muted sm:inline">Same threads</span>
        </div>

        <div class={`grid gap-10 ${secondaryPosts.length > 0 ? 'lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-12' : ''}`}>
          <article>
            <a href={`/blog/${featured.post.id}`} class="group block no-underline">
              <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-slate-100 dark:bg-zinc-800">
                {featured.post.data.thumbnail ? (
                  <Image
                    class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover:scale-[1.02]"
                    src={resizedThumbnail(featured.post.data.thumbnail, 900)}
                    alt={featured.post.data.title}
                    width={900}
                    height={560}
                  />
                ) : (
                  <div class="flex h-full w-full items-end p-6 text-sm text-slate-500 dark:text-slate-300">
                    No image for this one
                  </div>
                )}
              </div>
              <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs uppercase tracking-[0.12em] text-muted">
                <span>{featured.matchedTags[0]}</span>
                <span aria-hidden="true" class="text-border">/</span>
                <time datetime={new Date(featured.post.data.pubDate).toISOString()}>
                  {format(new Date(featured.post.data.pubDate), 'd MMM yyyy')}
                </time>
              </div>
              <h3 class="mt-3 mb-0 text-2xl font-semibold leading-tight tracking-tight text-ink transition-colors group-hover:text-accent sm:text-3xl">
                {featured.post.data.title}
              </h3>
              {featured.post.data.description && (
                <p class="mt-3 mb-0 text-base leading-relaxed text-ink2">
                  {featured.post.data.description}
                </p>
              )}
              <span class="mt-5 inline-block text-sm font-semibold text-ink underline decoration-border underline-offset-4 transition-colors group-hover:text-accent">
                Read the article
              </span>
            </a>
          </article>

          {secondaryPosts.length > 0 && (
            <ul class="m-0 list-none divide-y divide-line border-y border-line p-0">
              {secondaryPosts.map(({ post, matchedTags }) => (
                <li class="m-0 p-0">
                  <a href={`/blog/${post.id}`} class="group grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 py-5 no-underline first:pt-4 last:pb-4 sm:grid-cols-[7.5rem_minmax(0,1fr)]">
                    <div class="aspect-[4/3] overflow-hidden rounded-lg bg-slate-100 dark:bg-zinc-800">
                      {post.data.thumbnail ? (
                        <Image
                          class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover:scale-[1.03]"
                          src={resizedThumbnail(post.data.thumbnail, 240)}
                          alt={post.data.title}
                          width={240}
                          height={180}
                        />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-300">
                          No image
                        </div>
                      )}
                    </div>
                    <div class="min-w-0">
                      <div class="text-[11px] uppercase tracking-[0.1em] text-muted">{matchedTags[0]}</div>
                      <h3 class="mt-2 mb-0 text-lg font-semibold leading-snug text-ink transition-colors group-hover:text-accent">
                        {post.data.title}
                      </h3>
                      <time class="mt-2 block text-xs text-muted" datetime={new Date(post.data.pubDate).toISOString()}>
                        {format(new Date(post.data.pubDate), 'd MMM yyyy')}
                      </time>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )
}
