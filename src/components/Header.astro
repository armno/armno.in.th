---
import ThemeToggler from "./ThemeToggler.astro";

const { pathname } = Astro.url;
const hasSearch = Astro.slots.has("search");
const activeClass = "font-bold underline underline-offset-[5px]";
---

<header class="sticky top-0 z-10 flex items-center justify-between gap-6 bg-surface px-5 py-3.5 min-[820px]:px-[clamp(20px,4vw,56px)] min-[820px]:py-4">
  <a href="/" class="inline-block shrink-0 w-12 h-12 md:w-16 md:h-16">
    <svg
      class="w-12 h-12 md:w-16 md:h-16 motion-safe:hover:scale-125 motion-safe:hover:rotate-3 transition-transform"
      width="50"
      height="50"
      viewBox="0 0 50 50"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <title>armno.in.th logo</title>
      <rect width="50" height="50"></rect>
      <path
        d="M36.1111 34.8006L25 15.5556L13.8889 34.8006H15.6885L21.9948 23.8777L28.3011 34.8006H36.1111Z"
        class="fill-black dark:fill-slate-200"></path>
    </svg>
  </a>

  {hasSearch && (
    <div class="hidden min-[820px]:block flex-[0_1_460px] min-w-0">
      <slot name="search" />
    </div>
  )}

  <div class="flex items-center shrink-0">
    <nav class="flex dark:text-slate-200 text-[17px] gap-[18px] min-[820px]:text-xl min-[820px]:gap-[clamp(20px,3vw,40px)]">
      <a
        href="/"
        class={`inline-block ${pathname === "/" ? activeClass : "no-underline"}`}
        >About</a
      >
      <a
        href="/blog/"
        class={`inline-block ${
          pathname.includes("/blog/") ? activeClass : "no-underline"
        }`}>Blog</a
      >
      <a
        href="/uses/"
        class={`inline-block ${
          pathname.includes("/uses") ? activeClass : "no-underline"
        }`}>Uses</a
      >
    </nav>
    <ThemeToggler />
  </div>
</header>
